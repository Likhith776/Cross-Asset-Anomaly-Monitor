# Local docker-compose postgres (run `docker compose up -d postgres` first).
# For container-internal use (docker-compose services), use host `postgres` instead of `localhost`.
DATABASE_URL=postgresql://postgres:password@localhost:5432/market_anomalies

# Host view of docker-compose Kafka (containers override this with kafka:29092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=market-data
BACKEND_URL=http://fastapi:8000
# Tracked symbols + correlation pairs now live in config/universe.json
# (single source of truth, loaded by every service). The old ASSETS
# variable is no longer read by any code.

# Finnhub API key (https://finnhub.io — free tier: 60 calls/min).
# Empty = producer runs entirely on Yahoo Finance fallback.
# Optional: override symbol routing with JSON, e.g.
# FINNHUB_SYMBOL_MAP={"^GSPC":"^GSPC"}
FINNHUB_API_KEY=

# Gemini API key (https://aistudio.google.com/apikey — free tier).
# Empty = LLM anomaly explanations are OFF; everything else works
# identically. When set, high-severity anomalies get a short LLM
# explanation via the free-tier model gemini-2.5-flash, hard-capped
# by a built-in budget (6/hour, 30/day per process) so free-tier
# limits can never be exceeded.
GEMINI_API_KEY=

# Separate seeded demo dataset (dashboard DEMO mode). Empty disables demo mode.
# Create + seed it once:
#   docker exec postgres createdb -U postgres market_anomalies_demo
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/market_anomalies_demo python scripts/init_db.py
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/market_anomalies_demo python scripts/seed_demo_data.py
DEMO_DATABASE_URL=postgresql://postgres:password@localhost:5432/market_anomalies_demo

# Demo dataset auto-refresh interval (scheduler service). 21600 = every 6 hours.
DEMO_REFRESH_SECONDS=21600

# Postgres password (set a strong value BEFORE first deployment on a fresh
# volume; URL-encode special characters). Local dev default: password
POSTGRES_PASSWORD=password

# ---------------------------------------------------------------------------
# Runtime tuning — all optional; defaults shown match the code.
# ---------------------------------------------------------------------------

# Slim profile: fetch/detect cadence, API port, nightly backups (SLIM_BACKUPS=1
# enables; requires pg_dump on PATH; dumps to ./backups).
SLIM_FETCH_INTERVAL=30
SLIM_BATCH_INTERVAL=300
API_PORT=8000
SLIM_BACKUPS=0
# Backup output directory for pg_dump. Slim profile defaults to
# ./backups relative to the repo root; rarely needs overriding.
# BACKUP_DIR=./backups

# Kafka consumer group (feature-consumer uses feature-engineering-group,
# anomaly-consumer anomaly-detection-group).
CONSUMER_GROUP=feature-engineering-group

# LLM explanations: volatility-regime window around scheduled macro
# releases; higher = more anomalies annotated as macro-context.
MACRO_WINDOW_MINUTES=30

# Metrics exposition server (docker-compose assigns one port per service:
# producer 9101, feature-consumer 9102, anomaly-consumer 9103, scheduler
# 9104). Unset = no metrics server (slim/live-site profiles).
# METRICS_HTTP_PORT=9102

# Live-site CI pipeline: "composite" (default) layers keyless
# Coinbase/OXR primaries over retried Yahoo; any other value uses
# plain Yahoo only.
LIVE_PROVIDER=composite
# Retries against the secondary quote source when it throttles CI runners.
LIVE_SECONDARY_ATTEMPTS=2
LIVE_SECONDARY_WAIT=20
# Set to any value to skip the one-time 180-day historical backfill.
# SKIP_HISTORICAL_SEED=1

# Batch/init scripts: set DROP_EXISTING=1 to drop tables for a clean
# re-init (data loss!). Leave unset for normal idempotent creation.
# DROP_EXISTING=1
